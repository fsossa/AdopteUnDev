{% extends 'layouts/app.html.twig' %}


{% block title %}Fiche de poste
{% endblock %}

{% block main %}

	<main id="main" class="main">

		<div class="pagetitle">
			<h1>Fiches de poste</h1>
			<nav class="d-flex justify-content-between align-items-center">
				<ol class="breadcrumb m-0">
					<li class="breadcrumb-item">
						<a href="index.html">Home</a>
					</li>
					<li class="breadcrumb-item">Liste des fiches de poste</li>
					<li class="breadcrumb-item active">Profile</li>
				</ol>
			</nav>
		</div>


		<body>

			<div
				class="d-flex justify-content-between align-items-center mb-4 mt-4">
				<!-- Barre de recherche -->
				<div class="d-flex align-items-center flex-grow-1 me-3">
					<input type="text" class="form-control w-100 me-3" placeholder="Rechercher des offres..." aria-label="Search">
					<select class="form-select me-3" aria-label="Sélectionner un pays">
						<option selected>France</option>
						<option value="1">Autre pays</option>
					</select>
					{# <button class="btn btn-success">Tous les filtres</button> #}
				</div>

				<!-- Boutons Créer une alerte et Trier par pertinence -->
				<div class="d-flex align-items-center ms-3">
					<a class="btn btn-primary" href="{{ path('app_poste_new') }}">Créer une fiche de poste</a>
					{# <button class="btn btn-secondary">Trier par pertinence</button> #}
				</div>
			</div>


			<div class="container my-5">
				<div class="row d-flex flex-wrap">
					{% for poste in postes %}
						<div class="col-md-4 mb-4">

							<div
								class="card">
								{# <img src="https://via.placeholder.com/150" class="card-img-top" alt="Image de l'offre"> #}
								<div class="card-body">
									<h5 class="card-title display-6">{{ poste.title }}</h5>

									<p class="card-text">{{ poste.description }}</p>
									<div class="d-flex justify-content-between align-items-center mb-4">
										<div class="location">
											<i class="bi bi-geo-alt"></i>
											{{ poste.location }}
										</div>
										<small class="text-muted">{{ poste.getCreatedAt()|diffForHumans }}</small>
									</div>

									<div class="d-flex justify-content-end gap-2">
										<a class="btn btn-primary btn-sm" href="{{ path('app_poste_show', {'id': poste.id}) }}">
											<i class="bi bi-eye"></i>
										</a>

										<a class="btn btn-warning btn-sm" href="{{ path('app_poste_edit', {'id': poste.id}) }}">
											<i class="bi bi-pencil"></i>
										</a>
									</div>
								</div>
							</div>


						</div>
					{% else %}
						<div class="col-12">
							<p class="text-center">Aucune offre trouvée</p>
						</div>
					{% endfor %}
				</div>
			</div>


		</body>


	</main>
{% endblock %}
