{% extends 'layouts/app.html.twig' %}


{% block title %}Poste index
{% endblock %}

{% block main %}

	<main id="main" class="main">

		<div class="pagetitle">
			<h1>Profile</h1>
			<nav class="d-flex justify-content-between align-items-center">
				<ol class="breadcrumb m-0">
					<li class="breadcrumb-item">
						<a href="index.html">Home</a>
					</li>
					<li class="breadcrumb-item">Liste des fiches de poste</li>
					<li class="breadcrumb-item active">Profile</li>
				</ol>
			</nav>
		</div>


		<table class="table">
			<thead>
				<tr>
					<th>Id</th>
					<th>Title</th>
					<th>Description</th>
					<th>Location</th>
					<th>Experiences</th>
					<th>Min_salary</th>
					<th>Max_salary</th>
					<th>Created_at</th>
					<th>Updated_at</th>
					<th>actions</th>
				</tr>
			</thead>
			<tbody>
				{% for poste in postes %}
					<tr>
						<td>{{ poste.id }}</td>
						<td>{{ poste.title }}</td>
						<td>{{ poste.description }}</td>
						<td>{{ poste.location }}</td>
						<td>{{ poste.experiences }}</td>
						<td>{{ poste.minSalary }}</td>
						<td>{{ poste.maxSalary }}</td>
						<td>{{ poste.createdAt ? poste.createdAt|date('Y-m-d H:i:s') : '' }}</td>
						<td>{{ poste.updatedAt ? poste.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
						<td>
							<a href="{{ path('app_poste_show', {'id': poste.id}) }}">show</a>
							<a href="{{ path('app_poste_edit', {'id': poste.id}) }}">edit</a>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="10">no records found</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>

		<a class="btn btn-success" href="{{ path('app_poste_new') }}">Créer une fiche de poste</a>

	</main>
{% endblock %}
