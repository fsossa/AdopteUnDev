{% extends 'layouts/app.html.twig' %}


{% block title %}Fiche de poste

{% endblock %}

{% block main %}

	<main id="main" class="main">


		<h1>Fiche de poste</h1>

		<table class="table">
			<tbody>
				{# <tr>
													<th>Id</th>
													<td>{{ poste.id }}</td>
												</tr> #}
				<tr>
					<th>Titre</th>
					<td>{{ poste.title }}</td>
				</tr>
				<tr>
					<th>Description</th>
					<td>{{ poste.description }}</td>
				</tr>
				<tr>
					<th>Adresse</th>
					<td>{{ poste.location }}</td>
				</tr>
				<tr>
					<th>Années d'expérience requises</th>
					<td>{{ poste.experiences }}
						ans</td>
				</tr>
				<tr>
					<th>Salaire minimum</th>
					<td>{{ poste.minSalary }}</td>
				</tr>
				<tr>
					<th>Samaire Maximum</th>
					<td>{{ poste.maxSalary }}</td>
				</tr>
				<tr>
					<th>Créé le</th>
					<td>{{ poste.createdAt ? poste.createdAt|date('Y-m-d H:i:s') : '' }}</td>
				</tr>
				<tr>
					<th>Modifié dernièrement le</th>
					<td>{{ poste.updatedAt ? poste.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
				</tr>
			</tbody>
		</table>

		<a href="{{ path('app_poste_index') }}">Retourner en arrière</a>

		<a href="{{ path('app_poste_edit', {'id': poste.id}) }}">Modifier</a>

		{# {{ include('poste/_delete_form.html.twig') }} #}

	</main>

{% endblock %}
