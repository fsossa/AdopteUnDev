{% extends 'base.html.twig' %}

{% block title %}Poste{% endblock %}

{% block body %}
    <h1>Poste</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ poste.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ poste.title }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ poste.description }}</td>
            </tr>
            <tr>
                <th>Location</th>
                <td>{{ poste.location }}</td>
            </tr>
            <tr>
                <th>Experiences</th>
                <td>{{ poste.experiences }}</td>
            </tr>
            <tr>
                <th>Min_salary</th>
                <td>{{ poste.minSalary }}</td>
            </tr>
            <tr>
                <th>Max_salary</th>
                <td>{{ poste.maxSalary }}</td>
            </tr>
            <tr>
                <th>Created_at</th>
                <td>{{ poste.createdAt ? poste.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Updated_at</th>
                <td>{{ poste.updatedAt ? poste.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_poste_index') }}">back to list</a>

    <a href="{{ path('app_poste_edit', {'id': poste.id}) }}">edit</a>

    {{ include('poste/_delete_form.html.twig') }}
{% endblock %}
