{% extends 'base.html.twig' %}

{% block title %}Profil de {{ developer.name }}{% endblock %}

{% block body %}
    <h1>Profil de {{ developer.name }}</h1>
    <ul>
        <li>Email: {{ developer.email }}</li>
        <li>Compétences:
            <ul>
                {% for skill in developer.skills %}
                    <li>{{ skill.name }}</li>
                {% endfor %}
            </ul>
        </li>
    </ul>

    <a href="{{ path('app_developer_edit', {'id': developer.id}) }}" class="btn btn-primary">Modifier</a>
{% endblock %}
