{% extends 'base.html.twig' %}

{% block title %}Ajouter un nouveau développeur{% endblock %}

{% block body %}
    <h1>Ajouter un nouveau développeur</h1>

    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.email) }}
        <button type="submit" class="btn btn-primary">Enregistrer</button>
    {{ form_end(form) }}

    <a href="{{ path('app_developer_index') }}" class="btn btn-secondary">Retour à la liste</a>
{% endblock %}
