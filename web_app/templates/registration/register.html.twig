{% extends 'layouts/auth.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="container-fluid vh-100 d-flex align-items-center justify-content-center">
    <div class="row shadow-lg rounded overflow-hidden w-75">
        <div class="col-md-5 bg-primary text-white d-flex flex-column justify-content-center align-items-center p-5">
            <h1 class="fw-bold text-center">Démarrez votre voyage avec nous</h1>
        </div>
        <div class="col-md-7 bg-white p-5">
            <h2 class="fw-bold">Commençons!</h2>
            <p class="text-muted">Créez un compte pour continuer</p>
            <div class="d-flex justify-content-start mb-4">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="profileType" id="developer" value="developer" checked>
                    <label class="form-check-label fw-bold" for="developer">Développeur</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="profileType" id="company" value="company">
                    <label class="form-check-label fw-bold" for="company">Entreprise</label>
                </div>
            </div>
            
            <div id="developerForm">
                <form>
                    <div class="mb-3">
                        <label for="devName" class="form-label">Nom</label>
                        <input type="text" class="form-control" id="devName" required>
                    </div>
                    <div class="mb-3">
                        <label for="devEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="devEmail" required>
                    </div>
                    <div class="mb-3">
                        <label for="devPhone" class="form-label">Téléphone</label>
                        <input type="text" class="form-control" id="devPhone">
                    </div>
                    <div class="mb-3">
                        <label for="devPassword" class="form-label">Mot de passe</label>
                        <input type="password" class="form-control" id="devPassword" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Créer le compte</button>
                </form>
            </div>

            <div id="companyForm" class="d-none">
                <form>
                    <div class="mb-3">
                        <label for="compName" class="form-label">Nom de l'entreprise</label>
                        <input type="text" class="form-control" id="compName" required>
                    </div>
                    <div class="mb-3">
                        <label for="compEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="compEmail" required>
                    </div>
                    <div class="mb-3">
                        <label for="compPhone" class="form-label">Téléphone</label>
                        <input type="text" class="form-control" id="compPhone">
                    </div>
                    <div class="mb-3">
                        <label for="compPassword" class="form-label">Mot de passe</label>
                        <input type="password" class="form-control" id="compPassword" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Créer le compte</button>
                </form>
            </div>
            <p class="mt-3 text-center">Déjà un compte ? <a href="/login" class="text-primary">Connectez-vous</a></p>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('input[name="profileType"]').forEach((elem) => {
        elem.addEventListener("change", function(event) {
            if (event.target.value === "developer") {
                document.getElementById("developerForm").classList.remove("d-none");
                document.getElementById("companyForm").classList.add("d-none");
            } else {
                document.getElementById("companyForm").classList.remove("d-none");
                document.getElementById("developerForm").classList.add("d-none");
            }
        });
    });
</script>
{% endblock %}