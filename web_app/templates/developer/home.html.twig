							</h5>

							<div
								class="news">
								{# for #}
								{% for poste in bestPostes %}
									<div class="post-item clearfix">
										<img src="{{ asset('theme/app/assets/img/news-1.jpg') }}" alt="">
										<h4>
											<a href="#">{{ poste.title }}</a>
										</h4>
										<p>{{ poste.description }}...</p>
									</div>
									<small class="text-muted">{{ poste['created_at']|diffForHumans }}</small>
									<hr width="100%">
								{% else %}
									<div class="col-12">
										<p class="text-center">Aucune offre actuellement</p>
									</div>
								{% endfor %}
								{# <div class="container my-5">
									<div class="row d-flex flex-wrap">
