<div class="col-md-4 mb-4">
							<div
								class="card">
								<img src="https://via.placeholder.com/150" class="card-img-top" alt="Image de l'offre">
								<div class="card-body">
									<h5 class="card-title display-6">{{ poste.title }}</h5>

									<p class="card-text">{{ poste.description }}</p>
									<div class="d-flex justify-content-between align-items-center mb-4">
										<div class="location">
											<i class="bi bi-geo-alt"></i>
											{{ poste.location }}
										</div>
										<small class="text-muted">{{ poste.getCreatedAt()|diffForHumans }}</small>
									</div>

									<div class="d-flex justify-content-end gap-2">
										<a class="btn btn-primary btn-sm" href="{{ path('app_poste_show', {'id': poste.id}) }}">
											<i class="bi bi-eye"></i>
										</a>

										<a class="btn btn-warning btn-sm" href="{{ path('app_poste_edit', {'id': poste.id}) }}">
											<i class="bi bi-pencil"></i>
										</a>
									</div>
								</div>
							</div>


						</div>