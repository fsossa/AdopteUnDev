<div class="card">
	<div class="card-body profile-card pt-4 d-flex flex-column align-items-center">
		{% if developer is defined %}
			{% if developer.avatar %}
				<img src="{{ asset('uploads/dev_avatars/' ~ developer.avatar) }}" alt="Avatar" class="rounded-circle img-fluid" style="width: 500px; "/>
			{% else %}
				<img src="{{ asset('assets/images/user.png') }}" alt="Avatar" class="rounded-circle img-fluid" style="width: 500px; "/>
			{% endif %}
		{% else %}
			<img src="{{asset('theme/app/assets/img/profile-img.jpg')}}" alt="Profile" class="rounded-circle">
			{% if is_granted('ROLE_DEV') %}
				<h2>{{app.user.developer.firstname}}
					{{app.user.developer.lastname}}</h2>
			{% endif %}
			{% if is_granted('ROLE_COMPANY') %}
				<h2>{{app.user.company.name}}</h2>
				<h3>Développeur.se</h3>
			{% endif %}
		{% endif %}
		<div class="social-links mt-2">
			<a href="#" class="twitter">
				<i class="bi bi-twitter"></i>
			</a>
			<a href="#" class="facebook">
				<i class="bi bi-facebook"></i>
			</a>
			<a href="#" class="instagram">
				<i class="bi bi-instagram"></i>
			</a>
			<a href="#" class="linkedin">
				<i class="bi bi-linkedin"></i>
			</a>
		</div>
		<hr width="100%">
		{% if developer is defined %}
			Visites :
			{{(developer.visit_count ?? developer.companyVisiteDevelopers)|length}}
		{% else %}
			{% if is_granted('ROLE_DEV') %}
				Visites :
				{{app.user.developer.companyVisiteDevelopers|length}}
			{% endif %}
			{% if is_granted('ROLE_COMPANY') %}
				Postes :
				{{app.user.company.postes|length}}
			{% endif %}
		{% endif %}
	</div>
</div>
